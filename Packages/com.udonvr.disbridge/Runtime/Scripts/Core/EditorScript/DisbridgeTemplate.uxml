        <ui:Button text="Parse from Json" name="ParseButton" style="width: 105px; border-bottom-width: 1px; border-left-color: rgb(93, 93, 93); border-right-color: rgb(93, 93, 93); border-top-color: rgb(93, 93, 93); border-bottom-color: rgb(93, 93, 93); border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-direction: column; margin-right: 0; margin-left: 0;" />
