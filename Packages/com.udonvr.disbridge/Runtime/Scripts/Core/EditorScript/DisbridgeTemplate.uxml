<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement style="background-color: rgb(80, 80, 80); margin-bottom: 0; border-bottom-color: rgb(67, 67, 67); border-bottom-width: 5px; border-top-width: 5px; border-right-width: 5px; border-left-width: 5px; border-left-color: rgb(67, 67, 67); border-right-color: rgb(67, 67, 67); border-top-color: rgb(67, 67, 67); height: 70px; justify-content: center; align-items: center; margin-top: 0; flex-direction: row-reverse; border-top-left-radius: 5px; border-bottom-left-radius: 0; border-top-right-radius: 5px; border-bottom-right-radius: 0; flex-shrink: 0;">
        <Style src="DisbridgeStyle.uss" />
        <ui:Label text="Disbridge Editing Tool!" style="-unity-text-align: middle-center; font-size: 27px; white-space: normal; height: auto; align-items: center; justify-content: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; -unity-font: url(&apos;/Packages/com.udonvr.disbridge/Runtime/Plugins/Resources/Pacifico-Regular.ttf&apos;); color: rgb(255, 255, 255); -unity-font-style: normal; max-width: none;" />
        <ui:VisualElement style="background-image: url(&apos;/Packages/com.udonvr.disbridge/Runtime/Scripts/Core/EditorScript/BoyoGlow.png&apos;); width: 45px; height: 45px; margin-top: 0; justify-content: flex-start; align-items: center; flex-direction: column;" />
    </ui:VisualElement>
    <ui:ListView focusable="true" name="RoleContainer" style="height: 450px; background-color: rgb(80, 80, 80); flex-direction: column; display: flex; align-items: center; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0; justify-content: center; -unity-font-style: bold-and-italic; color: rgb(255, 255, 255); border-right-width: 5px; border-left-width: 5px; border-left-color: rgb(67, 67, 67); border-right-color: rgb(67, 67, 67); border-top-color: rgb(67, 67, 67); border-bottom-color: rgb(67, 67, 67); border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-top-width: 0; border-bottom-width: 0; flex-grow: 1;">
        <Style src="DisbridgeStyle.uss" />
